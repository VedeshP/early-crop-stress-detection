{
  "name": "kaggle",
  "target": "kaggle",
  "workspace": "workspace",
  "steps": ["data", "train", "evaluate"],

  "kaggle": {
    "user": "YOUR_KAGGLE_USERNAME",
    "dataset": null,
    "poll_seconds": 120,
    "download_outputs": ["train", "evaluate"]
  },

  "data": {"source": "prepare"},

  "prepare": {"mode": "relevant", "negative_fraction": 0.2, "max_output_gb": 19.0},

  "train_common": {
    "batch_size": 8,
    "num_workers": 4,
    "epochs": 25,
    "steps_per_epoch": 2000,
    "val_max_tiles": 3000,
    "time_limit_hours": 11.0,
    "final_tta": "flip"
  },

  "train_runs": [
    {"run_name": "segformer_b2_rgbn_idx", "arch": "segformer", "encoder": "mit_b2", "lr": 0.00006}
  ],

  "evaluate": {"batch_size": 8, "num_workers": 4}
}
